@model IEnumerable<_3DPrintsAPP.Data.Models.FilamentOption>

@{
    ViewData["Title"] = "Filament Options";
}

<h2 class="mb-4">Filament Options</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Option</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Brand</th>
            <th>Material</th>
            <th>Color</th>
            <th>Diameter</th>
            <th>Weight</th>
            <th>Photo</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var option in Model)
        {
            <tr>
                <td>@option.Brand</td>
                <td>@option.Material</td>
                <td>@option.FilamentColor</td>
                <td>@option.Diameter</td>
                <td>@option.WeightKG</td>
                <td>
                    <img src="@option.UploadPhoto" alt="@option.Brand" style="width:120px; height:auto;" />
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@option.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@option.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>