@model IEnumerable<_3DPrintsAPP.Data.Models.FilamentOption>

@{
    ViewData["Title"] = "Filament Options";
}

<div class="container">
    <div class="glass-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Filament Options</h2>

            <a asp-action="Create" class="btn btn-success">
                Add New Filament Option
            </a>
        </div>

        <div class="row g-4">
            @foreach (var f in Model)
            {
                <div class="col-md-4">
                    <div class="filament-card">
                        <img src="@f.UploadPhoto"
                             class="printer-img"
                             alt="@($"{f.Brand} {f.Material}")" />

                        <div class="filament-title">@f.Brand - @f.Material</div>

                        <div class="d-flex justify-content-center gap-2 flex-wrap mb-2">
                            <span class="pill ghost">@f.FilamentColor</span>
                            <span class="pill ghost">@f.Diameter mm</span>
                            <span class="pill ghost">@f.WeightKG kg</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>