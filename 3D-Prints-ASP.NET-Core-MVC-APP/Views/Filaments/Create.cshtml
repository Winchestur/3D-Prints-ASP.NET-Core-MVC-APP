@model _3DPrintsAPP.ViewModels.Filaments.FilamentCreateEditViewModel

@{
    ViewData["Title"] = "Create Filament";
}

<div class="container">
    <div class="glass-card">
        <h2 class="mb-4">Create Filament</h2>

        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="FilamentOptionId" class="form-label fw-bold"></label>
                <select asp-for="FilamentOptionId" asp-items="Model.FilamentOptions" class="form-select">
                    <option value="">-- Choose filament option --</option>
                </select>
                <span asp-validation-for="FilamentOptionId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Create</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}