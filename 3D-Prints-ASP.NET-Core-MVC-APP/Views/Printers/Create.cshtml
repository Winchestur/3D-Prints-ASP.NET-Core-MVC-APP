@model _3DPrintsAPP.ViewModels.Printers.PrinterCreateFromOptionViewModel

@{
    ViewData["Title"] = "Create Printer";
}

<h2 class="mb-4">Create Printer</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="PrinterOptionId" class="form-label"></label>
        <select asp-for="PrinterOptionId" asp-items="Model.PrinterOptions" class="form-select">
            <option value="">Choose printer option</option>
        </select>
        <span asp-validation-for="PrinterOptionId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}