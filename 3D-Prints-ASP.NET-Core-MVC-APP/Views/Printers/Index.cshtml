@using _3DPrintsAPP.ViewModels.Printers
@model IEnumerable<PrinterViewModel>

@{
    ViewData["Title"] = "Printers";
}

<div class="container">
    <div class="glass-card">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>My Printers</h2>

            <a asp-action="Create" class="btn btn-success">
                Add New Printer
            </a>
        </div>

        <div class="row g-4">
            @foreach (var p in Model)
            {
                <div class="col-md-4">
                    <div class="printer-card printer-card-link"
                         onclick="window.location='@Url.Action("Details", "Printers", new { id = p.Id })'">

                        <img src="@p.UploadPhoto"
                             class="printer-img"
                             alt="@p.ModelName" />

                        <div class="printer-title">@p.ModelName</div>

                        <div class="d-flex justify-content-center gap-2 flex-wrap mb-2">
                            <span class="pill ghost">Nozzle: @p.NozzleDiameter mm</span>
                            <span class="pill ghost">@(p.AMS ? "AMS" : "No AMS")</span>
                            <span class="pill ghost">@p.UploadedTime.ToShortDateString()</span>
                        </div>

                        <div class="printer-actions d-flex gap-2 mt-3"
                             onclick="event.stopPropagation();">
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-danger btn-sm">Delete</a>
                        </div>

                    </div>
                </div>
            }
        </div>

    </div>
</div>
