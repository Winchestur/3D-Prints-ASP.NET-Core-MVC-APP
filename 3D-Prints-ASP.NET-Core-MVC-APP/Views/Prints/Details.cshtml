@model PrintViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Print Details";
}

<div class="container">
    <div class="glass-card">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h2 class="mb-0">@Model.Title</h2>
                <div class="text-muted" style="opacity:.85;">
                    Uploaded: @Model.UploadedTime.ToString("dd.MM.yyyy")
                    @if (!string.IsNullOrWhiteSpace(Model.OwnerName))
                    {
                        <span>• Owner: @Model.OwnerName</span>
                    }
                </div>
            </div>

            @{
                var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
            }

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary">Back</a>

                @if (currentUserId == Model.OwnerId)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                }
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="details-image-wrap">
                    <img src="@Model.UploadPhoto"
                         alt="@Model.Title"
                         class="details-img" />
                </div>
            </div>

            <div class="col-lg-5">
                <div class="glass-card" style="padding:1.1rem;">

                    <div class="d-flex gap-2 flex-wrap mb-3">
                        <span class="pill">Print</span>
                        <span class="pill ghost">Time: @Model.PrintTime</span>

                        @if (Model.IsPublic)
                        {
                            <span class="pill ghost">Public</span>
                        }
                        else
                        {
                            <span class="pill ghost">Private</span>
                        }
                    </div>

                    <h4 class="mb-2">Description</h4>
                    <p class="details-desc">@Model.Description</p>

                    @if (!string.IsNullOrWhiteSpace(Model.OwnerName))
                    {
                        <h4 class="mt-3 mb-2">Owner</h4>
                        <p class="details-desc">@Model.OwnerName</p>
                    }

                </div>
            </div>
        </div>

    </div>
</div>