@model IEnumerable<_3DPrintsAPP.ViewModels.PrintViewModel>

@{
    ViewData["Title"] = "World Prints";
}

<div class="container">
    <div class="glass-card">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>World Prints</h2>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h4>No public prints yet</h4>
                <p class="text-muted">When users publish prints, they will appear here.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var p in Model)
                {
                    <div class="col-md-4">
                        <div class="printer-card printer-card-link"
                             onclick="window.location='@Url.Action("Details", "Prints", new { id = p.Id })'">

                            <img src="@p.UploadPhoto"
                                 class="printer-img"
                                 alt="@p.Title" />

                            <div class="printer-title">@p.Title</div>

                            <div class="d-flex justify-content-center gap-2 flex-wrap mb-2">
                                <span class="pill ghost">@p.PrintTime</span>
                                <span class="pill ghost">@p.UploadedTime.ToShortDateString()</span>
                                <span class="pill">Public</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(p.OwnerName))
                            {
                                <div class="text-center mb-2">
                                    <span class="pill ghost">By @p.OwnerName</span>
                                </div>
                            }

                            <div class="printer-actions d-flex gap-2 mt-3 flex-wrap"
                                 onclick="event.stopPropagation();">
                                <a asp-controller="Prints"
                                   asp-action="Details"
                                   asp-route-id="@p.Id"
                                   class="btn btn-warning btn-sm">
                                    Details
                                </a>

                                @if (!p.IsInCollection)
                                {
                                    <form asp-action="AddToCollection"
                                          asp-route-id="@p.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-sm">
                                            Add to My Collection
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="MyCollection"
                                          asp-action="RemoveFromCollection"
                                          asp-route-id="@p.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Remove
                                        </button>
                                    </form>
                                }
                            </div>

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>